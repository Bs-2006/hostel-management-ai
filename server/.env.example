# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://postgres:123@localhost:5434/hostel_management"

JWT_SECRET="your-super-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"

# xAI (Grok) API key for the AI chatbot. Get one at https://console.x.ai
XAI_API_KEY=""
# xAI chat completions endpoint
XAI_URL="https://api.x.ai/v1/chat/completions"
# Model to use (e.g. grok-4.6, grok-4.5, grok-4.3)
XAI_MODEL="grok-4.6"
